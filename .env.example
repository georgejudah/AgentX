# ─────────────────────────────────────────────────────────────
# AgentX environment config
# Copy this file to .env and fill in your values.
# The launch script (agentx.sh) loads it automatically.
# ─────────────────────────────────────────────────────────────

# ── Main LLM ─────────────────────────────────────────────────
# Pick ONE of the blocks below.

# Option A: OpenAI
AGENTX_PROVIDER=openai
AGENTX_MODEL=gpt-5-2025-08-07
OPENAI_API_KEY=sk-...

# Option B: Anthropic
# AGENTX_PROVIDER=anthropic
# AGENTX_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...

# Option C: OpenRouter (access hundreds of models with one key)
# AGENTX_PROVIDER=open_router
# AGENTX_MODEL=anthropic/claude-opus-4-8
# OPENROUTER_API_KEY=sk-or-...

# ── Grounding model ───────────────────────────────────────────
# Self-hosted UI-TARS or similar vision model that outputs click coordinates.
# See gui_agents/s3/README.md → "Grounding Models" for setup instructions.
AGENTX_GROUND_PROVIDER=huggingface
AGENTX_GROUND_URL=http://localhost:8080
AGENTX_GROUND_MODEL=ui-tars-1.5-7b
AGENTX_GROUND_API_KEY=
# UI-TARS-1.5-7B → 1920 x 1080  |  UI-TARS-72B → 1000 x 1000
AGENTX_GROUNDING_WIDTH=1920
AGENTX_GROUNDING_HEIGHT=1080

# ── Wake word ─────────────────────────────────────────────────
AGENTX_WAKE_PHRASE=hey agent
# Optional: get a free key at picovoice.ai/console for best wake-word quality.
# Without it, falls back to vosk (offline) or Google STT.
PICOVOICE_ACCESS_KEY=

# ── Webcam ────────────────────────────────────────────────────
# Index of your webcam device (0 = default/built-in).
AGENTX_CAMERA=0
